    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "display",
          "fontFamily": "\"Poppins\", system-ui, sans-serif"
        },
        {
          "slug": "sub",
          "name": "sub",
          "fontFamily": "\"Quicksand\", system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "body",
          "fontFamily": "\"Fenix\", Georgia, serif"
        }
