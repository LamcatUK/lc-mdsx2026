{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/featured-work",
	"title": "Featured Work",
	"category": "lc-mdsx2026",
	"icon": "portfolio",
	"description": "Portfolio projects laid out as groups of one large and two stacked tiles (alternating sides): the most recent, or hand-picked in your own order.",
	"attributes": {
		"backgroundShape": {
			"type": "string",
			"default": ""
		},
		"backgroundShapeColor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"default": "latest"
		},
		"projects": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"default": []
		},
		"count": {
			"type": "number",
			"default": 6
		},
		"discipline": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
