{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/press-names",
	"title": "Press Names",
	"category": "lc-mdsx2026",
	"icon": "megaphone",
	"description": "A strip of outlet names, each optionally linked to the article (as in the press list).",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "nero"
		},
		"backgroundShape": {
			"type": "string",
			"default": ""
		},
		"backgroundShapeColor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": "Work featured in"
		},
		"items": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
