{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/quote-block",
	"title": "Quote",
	"category": "lc-mdsx2026",
	"icon": "format-quote",
	"description": "Large pull quote with attribution.",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "nero"
		},
		"quote": {
			"type": "string",
			"default": ""
		},
		"cite": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
