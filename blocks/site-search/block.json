{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/site-search",
	"title": "Site Search",
	"category": "lc-mdsx2026",
	"icon": "search",
	"description": "The site search form with live results for projects, pages, people and news. Reads ?q= from the address.",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "nero"
		},
		"placeholder": {
			"type": "string",
			"default": "Search projects, people, news and pages"
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
