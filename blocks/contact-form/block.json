{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/contact-form",
	"title": "Contact Form",
	"category": "lc-mdsx2026",
	"icon": "email",
	"description": "Contact details beside a Contact Form 7 form. Fields, recipients and messages are set in Contact > Contact Forms.",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "nero"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"address": {
			"type": "string",
			"default": ""
		},
		"phone": {
			"type": "string",
			"default": ""
		},
		"email": {
			"type": "string",
			"default": ""
		},
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
