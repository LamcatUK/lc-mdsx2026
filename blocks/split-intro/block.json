{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/split-intro",
	"title": "Split Intro",
	"category": "lc-mdsx2026",
	"icon": "columns",
	"description": "Large statement left, lead paragraph right, optional row of facts.",
	"attributes": {
		"surface": {
			"type": "string",
			"default": "nero"
		},
		"statement": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"facts": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
