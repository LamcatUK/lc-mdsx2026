{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/feature-columns",
	"title": "Feature Columns",
	"category": "lc-mdsx2026",
	"icon": "grid-view",
	"description": "Heading plus N similar items (services, capabilities, specialisms, cross-links).",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "charcoal"
		},
		"backgroundShape": {
			"type": "string",
			"default": ""
		},
		"backgroundShapeColor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"layoutStyle": {
			"type": "string",
			"default": "columns"
		},
		"marks": {
			"type": "string",
			"default": "mark"
		},
		"minWidth": {
			"type": "number",
			"default": 18
		},
		"items": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
