{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/people-strip",
	"title": "People Strip",
	"category": "lc-mdsx2026",
	"icon": "groups",
	"description": "Short list of people (headshot, name, role, blurb) with optional press names.",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "nero"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"people": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": false,
			"link": false,
			"heading": false,
			"button": false
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
