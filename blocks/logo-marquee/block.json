{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/logo-marquee",
	"title": "Logo Marquee",
	"category": "lc-mdsx2026",
	"icon": "images-alt2",
	"description": "Scrolling strip of client logos.",
	"attributes": {
		"label": {
			"type": "string",
			"default": "Clients"
		},
		"logos": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
