{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/logo-marquee",
	"title": "Logo Marquee",
	"category": "lc-mdsx2026",
	"icon": "images-alt2",
	"description": "Client logos as a scrolling strip or a static grid, on a dark background with light logos or inverted: dark logos on a light background.",
	"attributes": {
		"label": {
			"type": "string",
			"default": "Clients"
		},
		"layout": {
			"type": "string",
			"default": "marquee"
		},
		"invert": {
			"type": "boolean",
			"default": false
		},
		"logos": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
