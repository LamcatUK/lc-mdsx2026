{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-mdsx2026/hero-reel",
	"title": "Hero Reel",
	"category": "lc-mdsx2026",
	"icon": "format-video",
	"description": "Full-bleed crossfading reel of chosen portfolio projects, with headline, CTAs and a \"now showing\" card tracking the current project.",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"lede": {
			"type": "string",
			"default": ""
		},
		"cta1Text": {
			"type": "string",
			"default": ""
		},
		"cta1Url": {
			"type": "string",
			"default": ""
		},
		"cta2Text": {
			"type": "string",
			"default": ""
		},
		"cta2Url": {
			"type": "string",
			"default": ""
		},
		"projects": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"default": []
		},
		"showCard": {
			"type": "boolean",
			"default": true
		},
		"cardLabel": {
			"type": "string",
			"default": "Now showing"
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": false
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
